---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolCard from '../../../components/ToolCard.astro';
import SkillCard from '../../../components/SkillCard.astro';
import { SITE, badgeById, platformById, pick, type Locale } from '../../../consts';
import { locales, localizedPath, type Lang } from '../../../i18n/utils';
import { getAllCollectionPages } from '../../../lib/collections';
import { getAllTools } from '../../../lib/tools';
import { getAllSkills } from '../../../lib/skills';

export async function getStaticPaths() {
  const pages = await getAllCollectionPages();
  return locales.flatMap((lang) =>
    pages.map((page) => ({ params: { lang, slug: page.id }, props: { lang, page } })),
  );
}

const { lang, page } = Astro.props as {
  lang: Lang;
  page: Awaited<ReturnType<typeof getAllCollectionPages>>[number];
};
const loc = lang as Locale;
const title = pick(page.data.title, loc);
const description = pick(page.data.description, loc);
const intro = pick(page.data.intro, loc);
const criteria = page.data.criteria[loc] ?? page.data.criteria.zh;
const faq = page.data.faq[loc] ?? page.data.faq.zh;

const tools = await getAllTools();
const skills = await getAllSkills();
const toolById = new Map(tools.map((tool) => [tool.id, tool]));
const skillById = new Map(skills.map((skill) => [skill.id, skill]));
const selectedTools = page.data.tools.map((id) => toolById.get(id)).filter(Boolean) as typeof tools;
const selectedSkills = page.data.skills.map((id) => skillById.get(id)).filter(Boolean) as typeof skills;
const recommendationCount = selectedTools.length + selectedSkills.length;
const abs = (p: string) => new URL(p, SITE.url).href;

const allCollections = await getAllCollectionPages();
const currentItemSet = new Set([...page.data.tools, ...page.data.skills]);
const relatedCollections = allCollections
  .filter((c) => c.id !== page.id)
  .map((c) => {
    const overlap = [...c.data.tools, ...c.data.skills].filter((id) => currentItemSet.has(id)).length;
    return { col: c, score: overlap * 10 + (c.data.featured ? 1 : 0) };
  })
  .sort((a, b) => b.score - a.score)
  .slice(0, 4)
  .map((x) => x.col);

const itemListElement = [
  ...selectedTools.map((tool, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: tool.data.name,
    url: abs(localizedPath(lang, `tools/${tool.id}`)),
  })),
  ...selectedSkills.map((skill, i) => ({
    '@type': 'ListItem',
    position: selectedTools.length + i + 1,
    name: skill.data.name,
    url: abs(localizedPath(lang, `skills/${skill.id}`)),
  })),
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: lang === 'zh' ? '首页' : 'Home', item: abs(localizedPath(lang, '')) },
      { '@type': 'ListItem', position: 2, name: lang === 'zh' ? '专题清单' : 'Collections', item: abs(localizedPath(lang, 'collections')) },
      { '@type': 'ListItem', position: 3, name: title, item: abs(localizedPath(lang, `collections/${page.id}`)) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: abs(localizedPath(lang, `collections/${page.id}`)),
    mainEntity: {
      '@type': 'ItemList',
      name: title,
      numberOfItems: recommendationCount,
      itemListElement,
    },
  },
  ...(faq.length > 0
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map(({ q, a }) => ({
          '@type': 'Question',
          name: q,
          acceptedAnswer: { '@type': 'Answer', text: a },
        })),
      }]
    : []),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="collection container section">
    <a class="back" href={localizedPath(lang, 'collections')}>
      ← {lang === 'zh' ? '返回专题清单' : 'Back to collections'}
    </a>

    <header class="hero-copy">
      <p class="eyebrow">{lang === 'zh' ? '免费软件专题' : 'Free Software Collection'}</p>
      <h1>{title}</h1>
      <p class="lede">{intro}</p>
      <p class="count">
        {recommendationCount}
        {' '}
        {lang === 'zh' ? '个精选推荐' : 'curated recommendations'}
      </p>
    </header>

    {criteria.length > 0 && (
      <section class="criteria">
        <h2>{lang === 'zh' ? '怎么挑' : 'Selection Criteria'}</h2>
        <ul>
          {criteria.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    {recommendationCount > 0 && (
      <section class="compare-matrix">
        <div class="section-head compact">
          <h2>{lang === 'zh' ? '一表看懂横向对比' : 'Quick Comparison Matrix'}</h2>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>{lang === 'zh' ? '名称' : 'Name'}</th>
                <th>{lang === 'zh' ? '核心定位' : 'Best For'}</th>
                <th>{lang === 'zh' ? '开源/协议' : 'License'}</th>
                <th>{lang === 'zh' ? '支持平台 / 客户端' : 'Platforms / Clients'}</th>
                <th>{lang === 'zh' ? '自由特性' : 'Freedom Highlights'}</th>
              </tr>
            </thead>
            <tbody>
              {selectedTools.map((tool) => (
                <tr>
                  <td class="col-name">
                    <a href={localizedPath(lang, `tools/${tool.id}`)}>{tool.data.name}</a>
                  </td>
                  <td class="col-desc">{pick(tool.data.tagline, loc)}</td>
                  <td class="col-lic">{tool.data.license || 'Free'}</td>
                  <td class="col-plat">
                    {tool.data.platforms
                      .map((p) => (platformById[p] ? pick(platformById[p].label, loc) : p))
                      .join(', ')}
                  </td>
                  <td class="col-badges">
                    {tool.data.badges
                      .slice(0, 4)
                      .map((b) => (badgeById[b] ? pick(badgeById[b].label, loc) : b))
                      .join(' · ')}
                  </td>
                </tr>
              ))}
              {selectedSkills.map((skill) => (
                <tr>
                  <td class="col-name">
                    <a href={localizedPath(lang, `skills/${skill.id}`)}>{skill.data.name}</a>
                  </td>
                  <td class="col-desc">{pick(skill.data.tagline, loc)}</td>
                  <td class="col-lic">{skill.data.license || 'Open Source'}</td>
                  <td class="col-plat">{skill.data.clients.slice(0, 4).join(', ')}</td>
                  <td class="col-badges">
                    {skill.data.badges
                      .slice(0, 4)
                      .map((b) => (badgeById[b] ? pick(badgeById[b].label, loc) : b))
                      .join(' · ')}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {selectedTools.length > 0 && (
      <section class="recommendations">
        <div class="section-head compact">
          <h2>{lang === 'zh' ? '推荐工具' : 'Recommended Tools'}</h2>
        </div>
        <div class="grid cards-grid">
          {selectedTools.map((tool) => <ToolCard tool={tool} lang={lang} />)}
        </div>
      </section>
    )}

    {selectedSkills.length > 0 && (
      <section class="recommendations">
        <div class="section-head compact">
          <h2>{lang === 'zh' ? '推荐 Skills & MCP' : 'Recommended Skills & MCP'}</h2>
        </div>
        <div class="grid cards-grid">
          {selectedSkills.map((skill) => <SkillCard skill={skill} lang={lang} />)}
        </div>
      </section>
    )}

    {faq.length > 0 && (
      <section class="faq">
        <h2>{lang === 'zh' ? '常见问题' : 'FAQ'}</h2>
        <dl>
          {faq.map(({ q, a }) => (
            <div class="qa">
              <dt>{q}</dt>
              <dd>{a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {relatedCollections.length > 0 && (
      <section class="related-collections">
        <div class="section-head compact">
          <h2>{lang === 'zh' ? '相关专题推荐' : 'Related Collections'}</h2>
        </div>
        <div class="rel-col-grid">
          {relatedCollections.map((rc) => (
            <a class="rel-col-card" href={localizedPath(lang, `collections/${rc.id}`)}>
              <h3>{pick(rc.data.title, loc)}</h3>
              <p>{pick(rc.data.description, loc)}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .collection {
    max-width: 1120px;
  }
  .back {
    display: inline-block;
    color: var(--text-soft);
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }
  .back:hover {
    color: var(--accent-ink);
  }
  .hero-copy {
    max-width: 780px;
    margin-bottom: 2rem;
  }
  .hero-copy h1 {
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    line-height: 1.08;
  }
  .lede {
    color: var(--text-soft);
    font-size: 1.08rem;
    line-height: 1.75;
    margin-top: 1rem;
  }
  .count {
    color: var(--text-faint);
    font-weight: 700;
    margin-top: 0.8rem;
  }
  .criteria {
    padding: 1.2rem 1.4rem;
    margin: 2rem 0 2.8rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .criteria h2,
  .faq h2 {
    font-size: 1.25rem;
    margin-bottom: 0.9rem;
  }
  .criteria ul {
    display: grid;
    gap: 0.6rem;
    padding-left: 1.2rem;
    color: var(--text-soft);
    line-height: 1.7;
  }
  .recommendations {
    margin-top: 2.6rem;
  }
  .compact {
    margin-bottom: 1.1rem;
  }
  .compact h2 {
    font-size: 1.45rem;
  }
  .faq {
    max-width: 820px;
    margin-top: 3rem;
  }
  .faq dl {
    display: grid;
    gap: 0.8rem;
  }
  .qa {
    padding: 1rem 1.15rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .qa dt {
    color: var(--text);
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .qa dd {
    color: var(--text-soft);
    line-height: 1.7;
  }
  .compare-matrix {
    margin: 2.2rem 0 2.8rem;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }
  th,
  td {
    padding: 0.78rem 1rem;
    border-bottom: 1px solid var(--border-soft);
    vertical-align: top;
  }
  th {
    background: var(--surface-2);
    color: var(--text);
    font-weight: 700;
    white-space: nowrap;
  }
  tbody tr:last-child td {
    border-bottom: none;
  }
  .col-name {
    font-weight: 700;
    white-space: nowrap;
  }
  .col-desc {
    color: var(--text-soft);
    min-width: 220px;
  }
  .col-lic {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-soft);
    white-space: nowrap;
  }
  .col-plat,
  .col-badges {
    color: var(--text-soft);
    font-size: 0.84rem;
  }
  .related-collections {
    margin-top: 3.4rem;
    padding-top: 2.2rem;
    border-top: 1px solid var(--border);
  }
  .rel-col-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }
  .rel-col-card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    transition: transform 0.16s var(--ease), border-color 0.16s;
  }
  .rel-col-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .rel-col-card h3 {
    font-size: 1rem;
    line-height: 1.35;
  }
  .rel-col-card p {
    font-size: 0.85rem;
    color: var(--text-soft);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
